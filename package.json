{
  "name": "prism-local-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Windows 本地指纹浏览器的产品规格与交互原型",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/application.test.ts tests/wails-adapter.test.ts tests/restore-source-owner.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test:ui": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run test:ui",
    "check:background": "npm run test && npm run typecheck && npm run build && npm run check:docs",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Action test",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Action build",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Action dev",
    "doctor:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Action doctor",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:kernel": "node scripts/verify-kernel.mjs",
    "setup:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-nsis.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "verify:installer": "node scripts/verify-installer.mjs"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
